# Parent folder of your Chrome profile. Open chrome://version and copy the
# Profile Path, then remove the last folder.
# Example: C:\Users\<USERNAME>\AppData\Local\Google\Chrome\User Data
CHROME_USER_DATA_DIR=

# Last folder of the Profile Path, such as Default or Profile 1.
# Do not paste the full path here.
CHROME_PROFILE=

GEMS_URL=https://gemini.google.com/gems/view
OUTPUT_DIR=output
LOG_DIR=logs

# Keep the browser visible while developing.
HEADLESS=false

# Save a screenshot and a structural DOM snapshot when a Gem fails.
DEBUG=false

NAVIGATION_TIMEOUT_MS=60000
ELEMENT_TIMEOUT_MS=20000
